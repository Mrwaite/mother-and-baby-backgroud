{
  "name": "mother-and-baby-backgroud",
  "version": "0.1.0",
  "private": true,
  "description": "母婴家庭记录小程序服务端（部署在微信云托管）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "sync-shared": "scripts/sync-shared.sh",
    "check-shared": "scripts/sync-shared.sh --check",
    "predeploy": "npm run check-shared && npm run typecheck && npm test"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "mysql-memory-server": "^1.18.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
