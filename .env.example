# 本地开发用的环境变量示例：复制为 .env 后修改。生产环境在云托管「服务设置 → 环境变量」中配置。
NODE_ENV=development
PORT=3000

# MySQL 内网地址 host:port（云托管手动开通的 MySQL 不会自动注入，需要自己填）
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=dev
MYSQL_DATABASE=mother_baby

# 对象存储（生产必填）：存储桶名称见「对象存储 → 存储配置」；CBR_ENV_ID 由云托管自动注入
# 本地不填时，照片登记只校验文件 ID 格式，也不会执行每日备份
# COS_BUCKET=
# COS_REGION=ap-shanghai
# CBR_ENV_ID=

# 每日备份开关，默认生产环境开启
# BACKUP_ENABLED=true

# 测试库（npm test）。不设置时自动用 mysql-memory-server 临时启动一个 MySQL 8.0
# MYSQL_TEST_ADDRESS=127.0.0.1:3306
# MYSQL_TEST_USERNAME=root
# MYSQL_TEST_PASSWORD=dev
# MYSQL_TEST_DATABASE=mother_baby_test
